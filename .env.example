# ============================================================
# LLM PROVIDER CONFIGURATION
# ============================================================
# Options: ollama | gemini | openrouter | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# ============================================================
# VISION LLM (for image/figure summarization)
# ============================================================
# Options: ollama | gemini | openrouter | openai
VLM_PROVIDER=ollama
VLM_MODEL=llava

# ============================================================
# EMBEDDING MODEL
# ============================================================
# Options: local | openai | gemini
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================
# API KEYS (only needed for cloud providers)
# ============================================================
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ============================================================
# OLLAMA CONFIGURATION
# ============================================================
# Use "http://ollama:11434" when running in Docker
# Use "http://localhost:11434" when running natively
OLLAMA_BASE_URL=http://ollama:11434

# ============================================================
# RETRIEVAL CONFIG
# ============================================================
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
TOP_K=5

# ============================================================
# CHUNKING CONFIG
# ============================================================
CHUNK_MAX_TOKENS=512
CHUNK_MERGE_PEERS=true

# ============================================================
# PDF INPUT
# ============================================================
# Path to your PDF file (relative to project root or absolute path)
# e.g., pdfs/sample.pdf or /kaggle/input/dataset/document.pdf
PDF_PATH=pdfs/sample.pdf

# ============================================================
# DATABASE & WEB APP CONFIG
# ============================================================
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/construction_rag
# In local dev: http://localhost:3001,http://127.0.0.1:3001
# In production on citerag.naimulworks.me:
CORS_ORIGINS=https://citerag.naimulworks.me,http://localhost:3001,http://127.0.0.1:3001
EMBEDDING_DIMENSION=384

# Host Port Bindings (Caddy reverse proxies to these local ports)
FRONTEND_PORT=127.0.0.1:3001
BACKEND_PORT=127.0.0.1:8000
POSTGRES_PORT=127.0.0.1:5433

# Optional: client-side API base url. Leave blank for relative path (recommended behind Caddy)
NEXT_PUBLIC_API_URL=

# ============================================================
# BETTER AUTH & GOOGLE OAUTH
# ============================================================
BETTER_AUTH_SECRET=supersecretbetterauthkey_at_least_32_chars_12345
# In local dev: http://localhost:3001
# In production on citerag.naimulworks.me:
BETTER_AUTH_URL=https://citerag.naimulworks.me
NEXT_PUBLIC_BETTER_AUTH_URL=https://citerag.naimulworks.me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

